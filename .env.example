# SettleAI Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database & Cache
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=settleai
POSTGRES_PASSWORD=settleai_password
POSTGRES_DB=settleai_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Stage 3 VLM Damage Inspection (Local Ollama minicpm-v:8b)
STAGE3_VLM_PROVIDER=ollama
STAGE3_OLLAMA_BASE_URL=http://localhost:11434
STAGE3_OLLAMA_MODEL=minicpm-v:8b
STAGE3_REQUEST_TIMEOUT_SECONDS=60.0

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
